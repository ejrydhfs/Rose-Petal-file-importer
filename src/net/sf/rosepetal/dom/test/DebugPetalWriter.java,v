package net.sf.rosepetal.dom.test;
import net.sf.rosepetal.dom.*;
import java.io.*;
import java.util.*;
/** this class writes out debug information from petal ast */
public class DebugPetalWriter extends PrintWriter
{
  /** current indentation level */
  int indentLevel = 0;
  /** indetation string */
  static final String indentString = "    ";
  /** constructor from writer */
  public DebugPetalWriter(Writer w)
  {
    super(w);
  }
  /** constructor from stream */
  public DebugPetalWriter(OutputStream o)
  {
    super(o);
  }

  /** increase indentation level */
  private void indent()
  {
    indentLevel++;
  }
  /** decrease indentation level */
  private void unindent()
  {
    indentLevel--;
  }

  /** print new line then indentation */
  private void nl()
  {
    println();
    for(int i = indentLevel;i>0;i--)
    {
      print(indentString);
    }
  }

  /** write out petal document */
  public void write(PetalDocument d)
  {
    println();
    println("File: "+d.getFile());
    println("Parent Present: "+(d.getParent() != null));
    writeObject(d.getHeader());
    println();
    println();
    writeObject(d.getBody());
    println();
  }

  private void writeObject(PetalObject o)
  {
    if(o == null)
    {
      print("<<NULL>>");
    }
    start();
    print(o.getMetaType());
    print(' ');
    print(o.getType());
    for(Iterator i = o.getArguments().iterator();i.hasNext();)
    {
      print(' ');
      writeValue(i.next());
    }
    for(Iterator i = o.getProperties().iterator();i.hasNext();)
    {
      PetalProperty p = (PetalProperty)i.next();
      nl();
      print(p.getName());
      print(' ');
      writeValue(p.getValue());
    }
    end();
  }

  void writeList(PetalListValue o)
  {
    if(o == null)
    {
      print("<<NULL>>");
    }
    start();
    print(o.getMetaType());
    print(' ');
    print(o.getType());
    for(Iterator i = o.getValues().iterator();i.hasNext();)
    {
      nl();
      writeValue(i.next());
    }
    end();
  }


  private void start()
  {
    print('(');
    indent();
  }

  private void end()
  {
    print(')');
    unindent();
  }

  private void writeValue(Object o)
  {
    if(o == null)
    {
      print("<<NULL>>");
    }
    else if(o instanceof PetalObject)
    {
      writeObject((PetalObject)o);
    }
    else if(o instanceof PetalListValue)
    {
      writeList((PetalListValue)o);
    }
    else if(o instanceof String)
    {
      print("{{");
      print(o);
      print("}}");
    }
    else
    {
      print(o);
    }
  }

}
