package net.sf.rosepetal.dom;
import java.util.*;
/** class for list values in petal file */
public final class PetalListValue extends PetalValue
{
  /** meta type value, always list */
  final private String metaType;
  /** type, could be null. it is currently ignored anyway */
  final private String type;
  /** values */
  final private List values = new ArrayList();
  /** unmodifiable value list */
  final private List uvalues = Collections.unmodifiableList(values);
  /** a constructor */
  public PetalListValue(int sl, int sc, String mt, String t)
  {
    super(sl,sc);
    metaType = mt;
    type = t;
  }
  /** get meta type of object */
  public String getMetaType()
  {
    return metaType;
  }
  /** get type of object */
  public String getType()
  {
    return type;
  }
  /** get values of the list */
  public List getValues()
  {
    return uvalues;
  }
  /** add value to the list */
  public void addValue(Object o)
  {
    values.add(o);
  }
  /** iterator over values */
  public Iterator iterator()
  {
    return values.iterator();
  }
}

