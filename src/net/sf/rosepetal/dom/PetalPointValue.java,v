package net.sf.rosepetal.dom;
/** class for point values in petal file */
public final class PetalPointValue extends PetalValue
{
  /** x value */
  final private int x;
  /** y value */
  final private int y;
  /** a constructor */
  public PetalPointValue(int sl, int sc, int _x, int _y)
  {
    super(sl, sc);
    x = _x;
    y = _y;
  }
  /** get x value */
  public int getX()
  {
    return x;
  }
  /** get y value */
  public int getY()
  {
    return x;
  }
  /** get debug info */
  public String toString()
  {
    return "("+x+", "+y+")";
  }

}
