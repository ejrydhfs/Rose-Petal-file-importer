package net.sf.rosepetal.ast;
import java.util.*;

public abstract class PBase
{
  public static final class RefInfo
  {
    final public String referrerRole;
    final public PBase referrer;
    RefInfo(String rr, PBase r)
    {
      referrerRole = rr;
      referrer = r;
    }
  }
  /** quid */
  String quid;
  /** parent role */
  String parentRole;
  /** parent object */
  PBase  parent;
  /** references this this object */
  ArrayList references = null;
  /** unmodifiable proxy to references */
  List references_uProxy = Collections.EMPTY_LIST;

  /** file where object is defined */
  private java.io.File file = null;
  /** line where object is defined */
  private int fileLine = -1;
  /** column where object is defined */
  private int fileColumn = -1;
  /** get parent */
  public PBase getParent()
  {
    return parent;
  }
  public void setFile(java.io.File f, int fl, int fc)
  {
    file = f;
    fileLine = fl;
    fileColumn = fc;
  }
  public java.io.File getSourceFile()
  {
    return file;
  }
  public int getSourceFileLine()
  {
    return fileLine;
  }
  public int getSourceFileColumn()
  {
    return fileColumn;
  }

  /** set parent for object */
  public void addReference(String pr, PBase p)
  {
    if(pr == null)
    {
      throw new IllegalArgumentException("parent role could not be null");
    }
    if(p == null)
    {
      throw new IllegalArgumentException("parent could not be null");
    }
    if(references == null)
    {
      references = new ArrayList();
      references_uProxy = Collections.unmodifiableList(references);
    }
    references.add(new RefInfo(pr,p));
  }

  /** set parent for object */
  public void setParent(String pr, PBase p)
  {
    if(pr == null)
    {
      throw new IllegalArgumentException("parent role could not be null");
    }
    if(p == null)
    {
      throw new IllegalArgumentException("parent could not be null");
    }
    if(parentRole != null)
    {
      throw new IllegalArgumentException("parent is already set");
    }
    parentRole = pr;
    parent = p;
  }

  public void setQuid(String qid)
  {
    quid = qid;
  }
  /**
   * set reference
   * @@return true, if it were actually set
   */
  public boolean setQuiduReference(String refName, PBase obj)
  {
    return false;
  }
}@
