  protected MStereotype getStereotype(String name)
  {
    if (name == null || name.length() == 0)
    {
      return null;
    }
    MStereotype rc = (MStereotype)name2sterotype.get(name);
    if (rc == null)
    {
      if (stereotypesPackage == null)
      {
        stereotypesPackage = (MPackage)umlModel.lookup(name);
        if (stereotypesPackage == null)
        {
          stereotypesPackage = factory.createPackage();
          stereotypesPackage.setName("Model Stereotypes");
          stereotypesPackage.setVisibility(MVisibilityKind.PUBLIC);
          stereotypesPackage.setSpecification(false);
          umlModel.addOwnedElement(stereotypesPackage);
        }
      }
      rc = (MStereotype)stereotypesPackage.lookup(name);
      if (rc == null)
      {
        rc = factory.createStereotype();
        rc.setName(name);
        rc.setVisibility(MVisibilityKind.PUBLIC);
        rc.setSpecification(false);
        stereotypesPackage.addOwnedElement(rc);
        name2sterotype.put(name, rc);
      }
    }
    return rc;
  }
