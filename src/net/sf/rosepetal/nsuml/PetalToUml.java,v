  protected void processOperation(MClassifier ctx, POperation pop, MOperation mop)
  {
    processElement(pop, mop);
    fillTaggedValues(mop);
    if (pop.getSemantics() != null) {
      mop.setSpecification(pop.getSemantics().getPDL());
    } else
      mop.setSpecification(null);
    if (pop.getPostCondition() != null && pop.getPostCondition().getPDL() != null) {
      MConstraint constr = factory.createConstraint();
      constr.setName("postCondition");
      constr.setBody(new ru.novosoft.uml.foundation.data_types.MBooleanExpression("",pop.getPostCondition().getPDL()));
      mop.addConstraint(constr);
    }
    if (pop.getPreCondition() != null && pop.getPreCondition().getPDL() != null) {
      MConstraint constr = factory.createConstraint();
      constr.setName("preCondition");
      constr.setBody(new ru.novosoft.uml.foundation.data_types.MBooleanExpression("",pop.getPreCondition().getPDL()));
      mop.addConstraint(constr);
    }
    Iterator i = pop.getParameters().iterator();
    while (i.hasNext())
    {
      PParameter pp = (PParameter)i.next();
      MParameter mp = factory.createParameter();
      processParameter(ctx, pp, mp);
      mop.addParameter(mp);
    }
    MParameter mret = factory.createParameter();
    mret.setName("");
    //System.err.println(ctx.getName()+" : "+pop.getName());
    if (pop.getResult() != null && pop.getResult().length() != 0 && !pop.getResult().equals("return"))
    {
      mret.setType(getClassByName(ctx, pop.getResult()));
    }
    mret.setKind(MParameterDirectionKind.RETURN);
    mop.addParameter(mret);

    MVisibilityKind vis = convertVisiblity(pop.getOpExportControl());
    mop.setVisibility(vis);

    //System.out.println("Operation: " + mop.getName() + " - " + vis.name() + " - " + pop.getExportControl());

    switch(pop.getConcurrency().getValue())
    {
      case PConcurrencyKind._SEQUENTIAL:
        mop.setConcurrency(MCallConcurrencyKind.SEQUENTIAL);
        break;

      case PConcurrencyKind._GUARDED:
        mop.setConcurrency(MCallConcurrencyKind.GUARDED);
        break;

      case PConcurrencyKind._SYNCHRONOUS:
        mop.setConcurrency(MCallConcurrencyKind.CONCURRENT);
        break;

      default:
        throw new RuntimeException("Concurrency "+pop.getConcurrency()+" is unknown");
    }

    String exs = pop.getExceptions();
    if (exs != null)
    {
      StringTokenizer stk = new StringTokenizer(exs, " ,", false);
      while (stk.hasMoreTokens())
      {
        String ex = stk.nextToken();
        mop.addRaisedSignal(getException(ctx, ex));
      }
    }
    PStateMachine sm = pop.getStatemachine();
      if (sm!= null) {
        ArrayList sms = new ArrayList();
        MStateMachine stM = factory.createStateMachine();
        processElement(sm,stM);
        fillTaggedValues(stM);
        processStateMachine(sm,stM);
        sms.add(stM);
        //mop.setBehaviors(sms);
        mop.addBehavior(stM);
      }
  }


  protected MClassifier createClass(PClass c)
  {
