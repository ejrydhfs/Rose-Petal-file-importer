/** instances of this class can be used to convert model
  * from petal file format to UML format.
  * Currently it only converts Logical View package.
  */

public class PetalToUml
{
  public static void main (String args[])
  {
    try
    {
      java.io.InputStream in = null;
      java.io.OutputStream out = null;
      java.io.File petalFile = null;
      if (args.length > 0)
      {
        petalFile = new File(args[0]);
      }
      else
      {
        System.err.println("need more args");
        return;
      }

      if (args.length < 2)
      {
        out = System.out;
      }
      else
      {
        out = new java.io.FileOutputStream(args[1]);
      }
      MModel m;
      long st = System.currentTimeMillis();
      m = parsePetalToUML(petalFile, new PrintWriter(System.err));
      System.err.println("Parsing finished: "+(System.currentTimeMillis()-st));
      XMIWriter xmiw = new XMIWriter(m, new PrintWriter(out));

      try
      {
        xmiw.gen();
      }
      catch(IncompleteXMIException ex)
      {
        Object objI = xmiw.getNotContainedElements().iterator();

        if (objI instanceof Iterator)
        {
          Iterator i = (Iterator)objI;
          while(i.hasNext())
          {
            Object obj = i.next();
            System.err.println("[Error] Model element '" + obj.toString() + "' is not contained.");
          }
        }
        else
        {
          java.util.Iterator i = (java.util.Iterator)objI;
          while(i.hasNext())
          {
            Object obj = i.next();
            System.err.println("[Error] Model element '" + obj.toString() + "' is not contained.");
          }
        }
      }
    }
    catch (Exception ex)
    {
      ex.printStackTrace();
    }
  }

  MFactory factory;
