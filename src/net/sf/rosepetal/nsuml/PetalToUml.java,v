  public MVisibilityKind convertVisiblity(PExportControlKind ec)
  {
    if(ec == null)
      return null;
    if(ec == PExportControlKind.IMPLEMENTATION)
      return null;
    if(ec == PExportControlKind.PRIVATE)
      return MVisibilityKind.PRIVATE;
    if(ec == PExportControlKind.PROTECTED)
      return MVisibilityKind.PROTECTED;
    if(ec == PExportControlKind.PUBLIC)
      return MVisibilityKind.PUBLIC;
    throw new RuntimeException("unknown export control " + ec);
  }
