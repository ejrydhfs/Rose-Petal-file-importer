  /** create a converter with given source model
    * @@param m a source model
    */
  public static MModel parsePetalToUML(File f, PrintWriter log)
  {
    MModel m = new MModelImpl();
    new PetalToUml((PDesign)(new PetalASTLoader(f,log)).parse(),m);
    return m;
  }


  public PetalToUml(PDesign m, MModel uml)
  {
    petalModel = m;
    umlModel = uml;
    factory = uml.getFactory();
    convert();
  }

  /** perform conversion
    */
  protected void convert()
  {
    // preprocess properties
    processProperties();
    // create all categories
    processCategories();
    // create all classes
    processAssociationClasses();
    // create all classes
    processClasses();
    // fill content of classes
    processClassContent();
    /// create all subsystem
    processSubSystem();

    // process all associtions
    processAssociations();
    // set model properties
    elementTaggedValues = modelTaggedValues;
    fillTaggedValues(umlModel);
  }


  public void processComponents(PSubSystem psubsyst,ru.novosoft.uml.model_management.MSubsystem msubsyst)
  {
    MComponent mcomp;
    PSubSystem pss  ;
    MSubsystem mss;
    MClassifier mcl;
    Iterator ii;
    PModule module = null;
    MElementResidence e_resid;
    Iterator i = psubsyst.getPhysicalModels().iterator();
    while (i.hasNext()) {
      PRoseItem o = (PRoseItem)i.next();
      if (o instanceof PModule)
      {
        module = (PModule)o;
        mcomp = factory.createComponent();
        processElement(module,mcomp);
        fillTaggedValues(mcomp);
        ii = ((ArrayList)module2classes.get(module)).iterator();
        while (ii.hasNext()) {
            PClass cl = (PClass)ii.next();
            mcl = (MClassifier)petalObj2umlObj.get(cl);
            e_resid = factory.createElementResidence();
            e_resid.setResident(mcl);
            e_resid.setVisibility(MVisibilityKind.forValue(0));
            mcomp.addResidentElement(e_resid);
        }
        msubsyst.addOwnedElement(mcomp);
      }
      else if (o instanceof PSubSystem)
      {
        pss = (PSubSystem)o;
        mss = factory.createSubsystem();
        processElement(pss,mss);
        fillTaggedValues(mss);
        processComponents(pss,mss);
        //msubsyst.addOwnedElement(comp,MVisibilityKind.PUBLIC, false);
        msubsyst.addOwnedElement(mss);
      }
    }
  }



  protected void processSubSystem()
  {
    PSubSystem psubsyst = petalModel.getRootSubsystem();
    if (psubsyst != null) {
        ru.novosoft.uml.model_management.MSubsystem msubsyst = new ru.novosoft.uml.model_management.MSubsystemImpl();
        processElement(psubsyst,msubsyst);
        fillTaggedValues(msubsyst);
        //processSubsystems(psubsyst,msubsyst);
        processComponents(psubsyst,msubsyst);
        umlModel.addOwnedElement(msubsyst);
    }
  }



  protected void processClassContent()
  {
    ArrayList classes = new ArrayList();
    getAllClasses(petalModel.getRootCategory(), classes);
    Iterator i = classes.iterator();
    while (i.hasNext())
    {
      PClass c = (PClass)i.next();
      MClassifier cls = (MClassifier)getElement(c);

      //System.out.println("Class " + c.getName());

      // process template arguments
      if (c instanceof PInstantiatedClass)
      {
        MBinding b = factory.createBinding();
        PInstantiatedClass ic = (PInstantiatedClass)c;
        if (ic.getInstantiation() != null)
        {
          PClass bc = ic.getInstantiation().getSupplier();
          b.addSupplier((MModelElement)getElement(bc));
          b.addClient(cls);
          Iterator k = ic.getParameters().iterator();
          while (k.hasNext())
          {
            PParameter p = (PParameter)k.next();
            if ((p.getType() != null && p.getType().length()!=0))
            {
              throw new IllegalStateException("parameters of class "+c.getName()+" cannot be handled");
            }
            b.addArgument(getClassByName(cls, p.getName()));
          }

          cls.getNamespace().addOwnedElement(b);
          b.setVisibility(MVisibilityKind.PRIVATE);
        }
      }

      cls.setAbstract(c.isAbstract());

      // process attributes
      Iterator j = c.getClassAttributes().iterator();
      while (j.hasNext())
      {
        PClassAttribute pat = (PClassAttribute)j.next();
        MAttribute mat = factory.createAttribute();
        processAttribute(cls, pat, mat);
        cls.addFeature(mat);
      }
      // process operations
      j = c.getOperations().iterator();
      while (j.hasNext())
      {

		  POperation pop = (POperation)j.next();
        MOperation mop = factory.createOperation();
        //System.out.println("  Operation " + pop.getName());
        processOperation(cls, pop, mop);
        cls.addFeature(mop);
      }
      // process inheritance
      j = c.getSuperclasses().iterator();
      while (j.hasNext())
      {
        PInheritanceRelationship pir = (PInheritanceRelationship)j.next();
        MGeneralization mgen = factory.createGeneralization();
        processGeneralization(pir, mgen);
        cls.addGeneralization(mgen);
        mgen.setVisibility(MVisibilityKind.PUBLIC);
        mgen.setSpecification(false);
        cls.addOwnedElement(mgen);
      }
      j = c.getRealizedInterfaces().iterator();
      while (j.hasNext())
      {
        PRealizeRelationship  d = (PRealizeRelationship)j.next();
        MAbstraction  md = factory.createAbstraction();
        processAbstraction(d, md);
        cls.addClientDependency(md);
        //cls.addOwnedElement(mgen, MVisibilityKind.PUBLIC, false);
      }
    }
  }

  protected void processAttribute(MClassifier ctx, PClassAttribute pat, MAttribute mat)
  {
    processElement(pat, mat);
    fillTaggedValues(mat);
    if (pat.getType() != null)
    {
      mat.setType(getClassByName(ctx, pat.getType()));
    }else {
      mat.setType(null);
    }
    mat.setInitialValue(new MExpression("", pat.getInitv()));
    MVisibilityKind vis = convertVisiblity(pat.getExportControl());
    mat.setVisibility(vis);
    //System.out.println("Attribute: " + mat.getName() + " - " + vis.name() + " - " + pat.getExportControl());

    MScopeKind sk;
    if (pat.isStatic())
    {
      sk = MScopeKind.CLASSIFIER;
    }
    else
    {
      sk = MScopeKind.INSTANCE;
    }
    mat.setOwnerScope(sk);
  }

  protected void processAssociations()
  {
    ArrayList as = new ArrayList();
    getAllAssociations(petalModel.getRootCategory(), as);
    Iterator i = as.iterator();
    while (i.hasNext())
    {
      PAssociation pa = (PAssociation)i.next();
      MAssociation ma;
      if (pa.getAssociationClass() == null)
      {
        ma = factory.createAssociation();

        processElement(pa, ma);
        elementTaggedValues.put("derived", pa.isDerived() ? "true" : "false");
        fillTaggedValues(ma);

        umlModel.addOwnedElement(ma);
      }
      else
      {
        ma = (MAssociation)getElement((PClass)assoc2class.get(pa));

        ma.setTaggedValue("derived", pa.isDerived() ? "true" : "false");
      }
      PRole r1 = (PRole)pa.getRoles().get(0);
      PRole r2 = (PRole)pa.getRoles().get(1);
      MAssociationEnd ae1 = factory.createAssociationEnd();
      MAssociationEnd ae2 = factory.createAssociationEnd();
      processRole(r1, r2, ae1);
      processRole(r2, r1, ae2);
      ma.addConnection(ae1);
      ma.addConnection(ae2);
    }
  }
  protected void processRole(PRole tr, PRole ar, MAssociationEnd ae)
  {
    //System.out.println("0");
    processElement(tr, ae);
    fillTaggedValues(ae);
    //System.out.println("1");
    ae.setNavigable(tr.isNavigable());
    //System.out.println("2");
    if (tr.getConstraints() != null && tr.getConstraints().equals("ordered"))
    {
      ae.setOrdering(MOrderingKind.ORDERED);
    }
    else
    {
      ae.setOrdering(MOrderingKind.UNORDERED);
    }
    //System.out.println("3");
    if (tr.isAggregate())
    {
      if (ar.getContainment() != null && (ar.getContainment().equals("ByValue") || ar.getContainment().equals("By Value")))
      {
        ae.setAggregation(MAggregationKind.COMPOSITE);
      }
      else
      {
        ae.setAggregation(MAggregationKind.AGGREGATE);
      }
    }
    else
    {
      ae.setAggregation(MAggregationKind.NONE);
    }
    //System.out.println("4");
    MScopeKind sk;
    if (tr.isStatic())
    {
      sk = MScopeKind.CLASSIFIER;
    }
    else
    {
      sk = MScopeKind.INSTANCE;
    }
    //System.out.println("5");
    ae.setTargetScope(sk);
    //System.out.println("6");
    String mm = tr.getClientCardinality();
    if (mm != null)
    {
      try
      {
        ae.setMultiplicity(new MMultiplicity(mm));
      }
      catch(Exception ex)
      {
        System.out.println("Multiplicity error: " + mm);
      }
    }

    //System.out.println("7");
    MVisibilityKind vis = convertVisiblity(tr.getExportControl());
    ae.setVisibility(vis);

    //System.out.println("AssociationEnd: " + ae.getName() + " - " + vis.name() + " - " + tr.getExportControl());

    //System.out.println("8");
    MClassifier mclsf = (MClassifier)(getClassByName((MClassifier)getElement(tr.getSupplier()), tr.getSupplier().getName()));
    mclsf.addAssociationEnd(ae);

    //System.out.println("9");
    Iterator i = tr.getKeys().iterator();
    while (i.hasNext())
    {
      PClassAttribute pat = (PClassAttribute)i.next();
      MAttribute mat = factory.createAttribute();
      processAttribute(mclsf, pat, mat);
      ae.addQualifier(mat);
    }
  }

  protected MClassifier unresolvedClass(MClassifier context, String name)
  {
    throw new IllegalArgumentException("name \'"+name+"\' could not be handled");
  }


  protected void processGeneralization(PInheritanceRelationship pir, MGeneralization mgen)
  {
    processElement(pir, mgen);
    fillTaggedValues(mgen);
    mgen.setParent((MClassifier)getElement(pir.getSupplier()));
  }
  protected void processAbstraction(PRealizeRelationship rr, MAbstraction usg)
  {
    processElement(rr, usg);
    fillTaggedValues(usg);
    usg.setStereotype(getStereotype("realize"));
    usg.addSupplier((MClassifier)getElement(rr.getSupplier()));
  }

  protected void processClasses()
  {
    ArrayList classes = new ArrayList();
    getAllClasses(petalModel.getRootCategory(), classes);
    Iterator i = classes.iterator();
    while (i.hasNext())
    {
      PClass c = (PClass)i.next();
      MClassifier cls = createClass(c);
      processElement(c, cls);
      if (cls instanceof MClass)
      {
        elementTaggedValues.put("persistence", c.getPersistence() == PPersistenceKind.PERSISTENT?"true":"false");
        ((MClass)cls).setActive(c.getConcurrency() == PConcurrencyKind.ACTIVE);
      }
      fillTaggedValues(cls);
      if (c instanceof PParameterizedClass)
      {
        Iterator k = ((PParameterizedClass)c).getParameters().iterator();
        while (k.hasNext())
        {
          PParameter p = (PParameter)k.next();
          if ((p.getType() != null && p.getType().length()!=0))
          {
            throw new IllegalStateException("parameters of class "+c.getName()+" cannot be handled");
          }
          MTemplateParameter tp = factory.createTemplateParameter();
          MClass pc = factory.createClass();
          pc.setName(convertName(p.getName()));
          tp.setModelElement2(pc);
          pc.setVisibility(MVisibilityKind.PRIVATE);
          cls.addTemplateParameter(tp);
          cls.addOwnedElement(pc);
        }
      }
      PStateMachine sm = c.getStatemachine();
      if (sm!= null) {
        ArrayList sms = new ArrayList();
        MStateMachine stM = factory.createStateMachine();
        processElement(sm,stM);
        fillTaggedValues(stM);
        processStateMachine(sm,stM);
        sms.add(stM);
        //cls.setBehaviors(sms);
        cls.addBehavior(stM);
        cls.addOwnedElement(stM);
      }

//      System.out.println("test "+c.getParentCategory().getName());
      MPackage pp = (MPackage)getElement(c.getParent());
      if (pp==null)
      {
        System.out.println("error");
      }
      cls.setVisibility(convertVisiblity(c.getExportControl()));
      cls.setSpecification(false);
      pp.addOwnedElement(cls);
      //System.out.println("Class: " + cls.getName() + " - " + vis.name() + " - " + c.getExportControl());
      if(c.getModule()!=null)
      {
        PModule m = c.getModule();
        ArrayList l = (ArrayList)module2classes.get(m);
        if(l == null)
        {
          l = new ArrayList();
          module2classes.put(m,l);
        }
        l.add(c);
      }

    }
  }
  public void processStateMachine(PStateMachine psm, MStateMachine ssm)
  {
      ArrayList msts = new ArrayList();
      // convertStates including transitions, transition must include Event
      List psts = psm.getStates();
      //System.out.println("here: "+psm.getName()+"  "+psts.size());
      Iterator ii = psts.iterator();
      processStates(psts,msts);
      MCompositeState compstate = factory.createCompositeState();
      Iterator i = msts.iterator();
      int k = 0;
      while (i.hasNext()) {
        //k++;
        MStateVertex stv = (MStateVertex)i.next();
        compstate.addSubvertex(stv);
        //System.out.println(k+" : "+stv.getName());
      }
      //compstate.setSubvertexes(msts);
      ssm.setTop(compstate);
      //convert states
      ii = psts.iterator();
      while(ii.hasNext()){
        PState pstate = (PState)ii.next();
        //System.out.println(pstate);
          if (!( pstate instanceof PSynchronizationState  /*pstate instanceof PActionState  || pstate instanceof PDecision */))
             {
                processStateTransitions(pstate);
             }
      }
  }


  HashMap name2class;

  protected MClassifier getClassByName(MClassifier context, String name)
  {
    if (name.indexOf('<') != -1)
    {
      int idx1 = name.indexOf('<');
      int idx2 = name.lastIndexOf('>');
      if (idx2 == -1)
      {
        return unresolvedClass(context, name);
      }
      String base = name.substring(0, name.indexOf('<')).trim();
      String paramsStr = name.substring(idx1, idx2+1);
      MClassifier baseClass = getClassByName(context, base);
      int idlv = 0;
      int i,n = paramsStr.length();
      List params = new ArrayList();
      int ppos = 0;

      MBinding b = factory.createBinding();

      for (i=0; i<n; i++)
      {
        switch (paramsStr.charAt(i))
        {
        case '<':
          idlv ++;
          break;
        case '>':
          idlv --;
          break;
        case ',':
          if (idlv == 0)
          {
            //params.add(getClassByName(context, paramsStr.substring(ppos,i).trim()));
            b.addArgument(getClassByName(context, paramsStr.substring(ppos,i).trim()));
            ppos = i+1;
          }
          break;
        }
      }
      if (idlv != 0)
      {
        return unresolvedClass(context, name);
      }

      //params.add(getClassByName(context, paramsStr.substring(ppos+1,n-1).trim()));
      b.addArgument(getClassByName(context, paramsStr.substring(ppos+1,n-1).trim()));

      //b.setArguments(params);
      b.addSupplier(baseClass);
      b.setVisibility(MVisibilityKind.PRIVATE);

      MClassifier c;

      try
      {
        c = (MClassifier)baseClass.getClass().newInstance();
        c.setStereotype(baseClass.getStereotype());
        c.setName(name);
        context.getNamespace().addOwnedElement(c);
      }
      catch(Exception ex)
      {
        throw new RuntimeException("Unexpected exception"+ex);
      }
      b.addClient(c);
      c.getNamespace().addOwnedElement(b);

      return c;
    }
    else if (name.indexOf('.') != -1)
    {
      return unresolvedClass(context, name);
    }
    else
    {
      Object objI = context.getTemplateParameters().iterator();
      if (objI instanceof Iterator)
      {
        Iterator i = (Iterator)objI;
        while (i.hasNext())
        {
          MTemplateParameter tp = (MTemplateParameter)i.next();
          MModelElement e = tp.getModelElement2();
          if (e instanceof MClassifier && e.getName().equals(name))
          {
            return (MClassifier)e;
          }
        }
      }
      else
      {
        java.util.Iterator i = (java.util.Iterator)objI;
        while (i.hasNext())
        {
          MTemplateParameter tp = (MTemplateParameter)i.next();
          MModelElement e = tp.getModelElement2();
          if (e instanceof MClassifier && e.getName().equals(name))
          {
            return (MClassifier)e;
          }
        }
      }

      MClassifier c = (MClassifier)context.lookup(name);
      if (c != null)
      {
        return c;
      }
      MNamespace ns = context.getNamespace();
      if (null != ns)
      {
        if(ns instanceof MClassifier)
        {
          return getClassByName((MClassifier)ns, name);
        }
        else
        {
          //System.out.println("name : "+name);
          c = (MClassifier)ns.lookup(name);
          if (c != null)
          {
            return c;
          }
        }
      }
      c = (MClassifier)umlModel.lookup(name);
      if (c != null)
      {
        return c;
      }
      c = (MClassifier)umlModel.lookup("Logical View::"+name);
      if (c != null)
      {
        return c;
      }
      if (name2class == null)
      {
        name2class = new HashMap();
        ArrayList classes = new ArrayList();
        getAllClasses(petalModel.getRootCategory(), classes);
        Iterator i = classes.iterator();
        while (i.hasNext())
        {
          PClass pc = (PClass)i.next();
          name2class.put(pc.getName(), getElement(pc));
        }
      }
      c = (MClassifier)name2class.get(name);
      if (c != null)
      {
        return c;
      }
      return unresolvedClass(context, name);
    }
  }


  protected void processStateTransitions(PState st){
    Iterator i;
    if (st.getTransitions().size() != 0) {
      i = st.getTransitions().iterator();
      while (i.hasNext()) {
          PStateTransition p_tr = (PStateTransition)i.next();
          MTransition m_tr = (MTransition)petalObj2umlObj.get(p_tr);
          processTransition(p_tr,m_tr);
      }
    }
    if (st.getStatemachine() != null && st.getStatemachine().getStates().size() != 0) {
      i = st.getStatemachine().getStates().iterator();
      while (i.hasNext()) {
        PState subst = (PState)i.next();
        if (!(subst instanceof PSynchronizationState /* || pstate instanceof PActionState  ||  subst instanceof PDecision*/))
             {
                 processStateTransitions(subst);
             }
      }
    }
  }

  protected void processState(PState pstate,MStateVertex mstate)
  {
     MTransition  m_tr ;
      String       when;
      MEvent me;
      PEvent pe;
      List         p_state_trs = pstate.getTransitions();
      ArrayList    m_state_trs = new ArrayList();
      processElement(pstate,mstate);
      fillTaggedValues(mstate);
      Iterator     i;
      String condition = null;
      MGuard guard;
      if (p_state_trs != null) {
          i = p_state_trs.iterator();
          while(i.hasNext()){
            PStateTransition p_tr = (PStateTransition)i.next();
            m_tr = factory.createTransition();
            processElement(p_tr,m_tr);
            fillTaggedValues(m_tr);
            pe = p_tr.getEvent();
            if (pe != null) {
                me = factory.createTimeEvent();
                String arg = pe.getParameters();
                if (arg != null && ! arg.equals("")) {
                  MParameter p ;
                  ArrayList args = new ArrayList();
                  StringTokenizer st = new StringTokenizer(arg,",");
                  while (st.hasMoreTokens()) {
                    p = factory.createParameter();
                    p.setName(st.nextToken().trim());
                    args.add(p);
                    me.addParameter(p);
                  }
                  //me.setParameters(args);
                }
                processElement(pe,me);
                fillTaggedValues(me);
                m_tr.setTrigger(me);
            } else
