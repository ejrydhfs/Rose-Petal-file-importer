  /** Get model element property */
  public String getElementProperty(MModelElement e, String tool, String name)
  {
    // Check query property set
    if (name.equals("cg_style"))
    {
      // Check property set
      String setname = e.getTaggedValue(propertyTag + tool);
      if (null == setname)
      {
         return defaultPropertySet;
      }
      return setname;
    }

    // Check property value
    String value = e.getTaggedValue(propertyTag + tool + "." + name);
    if (null == value)
    {
      // Check property set
      String setname = e.getTaggedValue(propertyTag + tool);
      if (null == setname)
      {
         setname = defaultPropertySet;
      }

      // Try to get default value
      value = getDefaultProperty(e.getUMLClassName(), tool, setname, name);
      if (value == null)
      {
        throw new IllegalArgumentException("Property '" + tool + "." + e.getUMLClassName() + "." + setname + "." + name + "' not exist");
      }
    }

    return value;
  }


  protected void processProperties()
  {
    Iterator i = petalModel.getProperties().getAttributes().iterator();
    while (i.hasNext())
    {
      PAttribute p = (PAttribute)i.next();
      if (!acceptPropertyTool(p.getTool()))
      {
        continue;
      }
      String nm = p.getName();
      if ("HiddenTool".equals(nm))
      {
        // ignore
      }
      else if ("propertyId".equals(nm))
      {
        // ignore
      }
      else
      {
        int idx = nm.lastIndexOf("__");
        if (idx != -1 && p.getValue() instanceof PAttributeListValue)
        {
          PAttributeListValue psv = (PAttributeListValue)p.getValue();
          String sfx = nm.substring(idx);

          // scan properties
          Iterator j = psv.getValue().iterator();
          while (j.hasNext())
          {
            PAttribute prop = (PAttribute)j.next();
            if (!(prop.getValue() instanceof PAttributeListValue))
            {
              Object classname = class2typeSuffixUML.get(sfx);

              if (null != classname)
              {
                if (classname instanceof List)
                {
                  Iterator k = ((List)classname).iterator();
                  while (k.hasNext())
                  {
                    setDefaultProperty(
                      (String)k.next(),
                      p.getTool(),
                      nm.substring(0, idx),
                      prop.getName(),
                      convertPropertyValue2(prop)
                    );
                  }
                }
                else if (classname instanceof String)
                {
                  setDefaultProperty(
                    (String)classname,
                    p.getTool(),
                    nm.substring(0, idx),
                    prop.getName(),
                    convertPropertyValue2(prop)
                  );
                }
              }
            }
          }
        }
      }
    }
  }
