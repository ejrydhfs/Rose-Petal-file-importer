  protected void  processAssociationClasses()
  {
    ArrayList as = new ArrayList();
    getAllAssociations(petalModel.getRootCategory(), as);
    Iterator i = as.iterator();
    while (i.hasNext())
    {
      PAssociation pa = (PAssociation)i.next();
      if(pa.getAssociationClass() != null)
      {
        StringTokenizer stk = new StringTokenizer(
          pa.getAssociationClass(),":",false);
        if(stk.hasMoreTokens())
        {
          String h = stk.nextToken();
          PClassCategory root;
          if("Logical View".equals(h))
          {
            root = petalModel.getRootCategory();
          }
          else
          {
            throw new RuntimeException("Failed to process association class"+pa.getAssociationClass());
          }
          PRoseItem cur = root;
          while(cur instanceof PClassCategory )
          {
            PClassCategory cat = (PClassCategory)cur;
            String tk = null;
            while(stk.hasMoreTokens())
            {
              tk = stk.nextToken();
              if(tk.length() > 0)
                break;
            }
            if(tk == null)
              break;
            for(Iterator iter = cat.getLogicalModels().iterator();iter.hasNext();)
            {
              PRoseItem ri = (PRoseItem)iter.next();
              if(tk.equals(ri.getName()))
              {
                cur = ri;
                break;
              }
            }
          }
          if(cur instanceof PClass)
          {
            class2assoc.put(cur,pa);
            assoc2class.put(pa,cur);
          }
        }
      }
    }
  }

