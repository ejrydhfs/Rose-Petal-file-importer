  /** Default property set name */
  public static final String defaultPropertySet = "default";

  /** Property tag */
  public static final String propertyTag = "property.";

  /** convert property value to string */
  private String convertPropertyValue2(PAttribute p)
  {
    PAttributeValue pv = (PAttributeValue)p.getValue();
    if (pv instanceof PAttributeEnumValue)
    {
      PAttributeEnumValue v = (PAttributeEnumValue)pv;
      return String.valueOf(v.getValue());
    }
    else if (pv instanceof PAttributeStringValue)
    {
      PAttributeStringValue v = (PAttributeStringValue)pv;
      return v.getValue();
    }
    else if (pv instanceof PAttributeBooleanValue)
    {
      PAttributeBooleanValue v = (PAttributeBooleanValue)pv;
      return v.isValue()?"true":"false";
    }
    else if (pv instanceof PAttributeIntValue)
    {
      PAttributeIntValue v = (PAttributeIntValue)pv;
      return Integer.toString(v.getValue());
    }
    else
    {
      throw new IllegalArgumentException("Unsupported property class: "+pv.getClass().getName());
    }
  }

  /** convert properties from PElement to MElement */
  HashMap elementTaggedValues = null;
  protected void convertProperties(PElement p, MModelElement m)
  {
    elementTaggedValues = new HashMap();

    String sfx = (String)class2typeSuffix.get(p.getClass());
    if (sfx == null)
    {
      return;
    }

    // get all non default tools
    List props = p.getAttributes();
    if (props != null) {
        Iterator i = props.iterator();

        while (i.hasNext())
        {
          PAttribute prop = (PAttribute)i.next();
          String toolname = prop.getTool();
          if (!acceptPropertyTool(toolname))
          {
            continue;
          }
          setElementProperty(m, toolname, prop.getName(), convertPropertyValue2(prop));
      }
    }
  }
 /** Set model element property */
  public void setElementProperty(MModelElement e, String tool, String name, String value)
  {
    // Check property set
    String setname = (String)elementTaggedValues.get(propertyTag + tool);
    if (null == setname)
    {
       setname = defaultPropertySet;
    }

    // Check attempt change property set
    if (name.equals("cg_style") && !setname.equals(value))
    {
      elementTaggedValues.put(propertyTag + tool, value);
      return;
    }

    // Check default property value
    String defaultvalue = getDefaultProperty(e.getUMLClassName(), tool, setname, name);
    if (null == defaultvalue)
    {
      elementTaggedValues.put(propertyTag + tool + "." + name, value);
    }
    else
    {
      if (defaultvalue.equals(value))
      {
        elementTaggedValues.remove(propertyTag + tool + "." + name);
      }
      else
      {
        elementTaggedValues.put(propertyTag + tool + "." + name, value);
      }
    }
  }
  /** Set default property */
  HashMap modelTaggedValues = new HashMap();
  public void setDefaultProperty(String classname, String tool, String setname, String name, String value)
  {
    if (null == setname)
    {
      setname = defaultPropertySet;
    }

    modelTaggedValues.put(propertyTag + classname + "." + tool + "." + setname + "." + name, value);
  }

  /** Get model element property */
  public String getDefaultProperty(String classname, String tool, String setname, String name)
  {
    if (null == setname)
    {
      setname = defaultPropertySet;
    }

    return (String)modelTaggedValues.get(propertyTag + classname + "." + tool + "." + setname + "." + name);
  }

