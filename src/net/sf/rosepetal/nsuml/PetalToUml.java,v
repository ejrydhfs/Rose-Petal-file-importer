        if ( c.getStereotype().equals("primitive") )
        {
          return factory.createClass();
          //return factory.createPrimitive();
        }
        else if (c.getStereotype().equals("exception") )
        {
          return  factory.createException();
        }
      }
      return factory.createClass();
    }
    else
    {
      MClassifier cls = factory.createAssociationClass();
      enlistMapping((PAssociation)class2assoc.get(c), cls);
      return cls;
    }
  }

