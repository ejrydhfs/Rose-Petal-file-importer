package net.sf.rosepetal.genast;


import ru.novosoft.mdf.ext.*;
import ru.novosoft.mdf.impl.*;
import javax.jmi.model.*;
import java.util.*;
import java.io.*;

/** this is a temporary generator that generates mof interfaces */
public class ASTGenEnum extends ASTGenWriter
{
  EnumerationType modelElement;
  ASTGenEnum(ASTGen g, EnumerationType e) throws IOException
  {
    super(g, g.getNamespace(e.getContainer()), "P"+g.getName1(e)+".java");
    modelElement = e;
    try
    {
      line("package "+g.getNamespace(e.getContainer())+";");
      String tn = g.getTypeName(e);
      line("public final class "+tn);
      sblock();
      {
        line("final private String name;");
        line("final private int value;");
        line("final public String getName(){return name;}");
        line("final public int getValue(){return value;}");
        int n = 1;
        for (Iterator i = modelElement.getLabels().iterator(); i.hasNext(); )
        {
          String label = (String)i.next();
          String ulabel = NameUtil.getId3(label);
          line("public static final int _"+ulabel+" = "+n+";");
          n++;
          line("public static final "+tn+" "+ulabel+" = new "+
            tn+"(\""+label+"\",_"+ulabel+");" );
        }
        line("private "+tn+"(String nm, int val)");
        sblock();
        {
          line("name = nm;");
          line("value = val;");
        }
        eblock();

        line("public static "+tn+" forName(String s)");
        sblock();
        {
          for (Iterator i = modelElement.getLabels().iterator(); i.hasNext(); )
          {
            String label = (String)i.next();
            String ulabel = NameUtil.getId3(label);
            sif("\""+label+"\".equals(s)");
            {
              line("return "+ulabel+";");
            }
            eif();
          }
          sif("null == s");
          {
            line("return null;");
          }
          eif();
          line("throw new IllegalArgumentException(\"Label not recognized: \"+s);");
        }
        eblock();

        line("public static "+tn+" forValue(int n)");
        sblock();
        {
          for (Iterator i = modelElement.getLabels().iterator(); i.hasNext(); )
          {
            String label = (String)i.next();
            String ulabel = NameUtil.getId3(label);
            sif("n == _"+ulabel);
            {
              line("return "+ulabel+";");
            }
            eif();
          }
          line("throw new IllegalArgumentException(\"Value not recognized: \"+n);");
        }
        eblock();
      }
      eblock();
    }
    finally
    {
      close();
    }
  }
}
