package net.sf.rosepetal.genast;


import ru.novosoft.mdf.ext.*;
import ru.novosoft.mdf.impl.*;
import javax.jmi.model.*;
import java.util.*;
import java.io.*;

/** this is a temporary generator that generates mof interfaces */
public class ASTGenClass extends ASTGenWriter
{
  final MofClass modelElement;
  final String typeName;
  ASTGenClass(ASTGen g, MofClass e) throws IOException
  {
    super(g, g.getNamespace(e.getContainer()), "P"+g.getName1(e)+".java");
    try
    {
      modelElement = e;
      typeName = g.getTypeName(e);

      line("package "+g.getNamespace(e.getContainer())+";");
      line("import java.util.List;");
      line("import java.util.ArrayList;");
      line("import java.util.Collections;");

      final String a = e.isAbstract()?"abstract ":"";
      sline("public "+a+"class "+typeName+" extends ");
      MofClass st = (MofClass)g.getOneValue(e.getSupertypes());
      if(st == null)
        println("PBase");
      else
        println(g.getTypeName(st));
      sblock();
      {
        for(Iterator i=e.getContents().iterator();i.hasNext();)
        {
          ModelElement me = (ModelElement)i.next();
          if(me instanceof Attribute)
          {
            generateAttribute((Attribute)me);
          }
          if(me instanceof Reference)
          {
            generateReference((Reference)me);
          }
        }
      }
      generateSetQuidu();
      eblock();
    }
    finally
    {
      close();
    }
  }


  void generateReference(Reference me)
  {
    Classifier c = me.getType();
    String t = getTypeName(c);
    String vn = vname(me);
    line("// generating reference "+me.getQualifiedName());
    if(me.getMultiplicity().getUpper() ==  1)
    {
      line("private "+t+" "+vn+";");
      line("public "+t+" "+getter(me)+"{return "+vn+";}");
      line("void "+setter(me,t+" __arg__"));
      sblock();
      {
        line("__arg__.addReference(\""+me.getName()+"\",this);");
        line(vn+" = __arg__;");
      }
      eblock();
    }

  }


  void generateAttribute(Attribute me)
  {
    Classifier c = me.getType();
    String t = getTypeName(c);
    String vn = vname(me);
    if(c instanceof MofClass)
    {
      line("// generating attibute "+me.getQualifiedName());
      if(me.getMultiplicity().getUpper() ==  1)
      {
        line("private "+t+" "+vn+";");
        line("public "+t+" "+getter(me)+"{return "+vn+";}");
        line("void "+setter(me,t+" __arg__"));
        sblock();
        {
          line("__arg__.setParent(\""+me.getName()+"\",this);");
          line(vn+" = __arg__;");
        }
        eblock();
      }
      else
      {
        String pvn = vn + "_uProxy";
        line("private ArrayList "+vn+" = null ;");
        line("private List "+pvn+" = Collections.EMPTY_LIST ;");
        line("public List "+getter(me)+"{return "+pvn+";}");
        line("void add"+getName1(me)+"("+t+" __arg__)");
        sblock();
        {
          sif(vn+" == null");
          {
            line(vn+" = new ArrayList();");
            line(pvn+" = Collections.unmodifiableList("+vn+");");
          }
          eif();
          line("__arg__.setParent(\""+me.getName()+"\",this);");
          line(vn+".add(__arg__);");
        }
        eblock();
      }
    }
    else if(c instanceof PrimitiveType || c instanceof EnumerationType)
    {
      if("IgnoredValue".equals(c.getName()))
        return;
      if(me.getMultiplicity().getUpper() !=  1)
      {
        line("// UNSUPPORTED attibute "+me.getQualifiedName());
        return;
      }

      line("// generating attibute "+me.getQualifiedName());
      line("private "+t+" "+vn+";");
      line("public "+t+" "+getter(me)+"{return "+vn+";}");
      line("void "+setter(me,t+" __arg__")+"{"+vn+" = __arg__;}");
    }
    else
    {
      throw new IllegalArgumentException("attribute type is not supported "+c.getQualifiedName());
    }
  }

  void generateSetQuidu()
  {
    line("public boolean setQuiduReference(String refName, PBase obj)");
    sblock();
    {
      for(Iterator i=modelElement.getContents().iterator();i.hasNext();)
      {
        ModelElement me = (ModelElement)i.next();
        if(me instanceof Reference)
        {
          Reference ref = (Reference)me;
          sif("\""+ref.getName()+"\".equals(refName)");
          {
            line(""+setter(ref,"("+getTypeName(ref.getType())+")obj")+";");
            line("return true;");
          }
          eif();
        }
      }
      line("return super.setQuiduReference(refName, obj);");
    }
    eblock();
  }

}
