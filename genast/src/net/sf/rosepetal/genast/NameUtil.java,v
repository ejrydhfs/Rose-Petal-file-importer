package net.sf.rosepetal.genast;
import java.util.*;

/**
 *  utilities for creating and parsing names
 *
 * @@author    cap
 * @@since     0.1.0
 */
public class NameUtil {
  /**
   *  get indentifier in MOF indentifier 1 format. All words are in upercased
   *  format. {WOrd1 word2 Word3} =>WOrd1Word2Word3.
   *
   * @@param  s  input indentifer
   * @@return    value in id1 format
   * @@since     0.0.1
   */
  public static String getId1(String s) {
    List ws = parseId(s);
    StringBuffer rc = new StringBuffer();
    for (Iterator i = ws.iterator(); i.hasNext(); ) {
      String w = (String)i.next();
      rc.append(Character.toUpperCase(w.charAt(0)));
      rc.append(w.substring(1));
    }
    return rc.toString();
  }


  /**
   *  get indentifier in MOF indentifier 2 format. All words are in upercased
   *  format. {WOrd1 word2 Word3} =>word1_word2_word3.
   *
   * @@param  s  input indentifer
   * @@return    value in id2 format
   * @@since     0.0.1
   */
  public static String getId2(String s) {
    List ws = parseId(s);
    StringBuffer rc = new StringBuffer();
    boolean first = true;
    for (Iterator i = ws.iterator(); i.hasNext(); ) {
      if (first) {
        first = false;
      } else {
        rc.append('_');
      }
      String w = (String)i.next();
      rc.append(w.toLowerCase());
    }
    return rc.toString();
  }


  /**
   *  get indentifier in MOF indentifier 3 format. All words are in upercased
   *  format. {WOrd1 word2 Word3} =>WORD1_WORD2_WORD3.
   *
   * @@param  s  input indentifer
   * @@return    value in id3 format
   * @@since     0.0.1
   */
  public static String getId3(String s) {
    List ws = parseId(s);
    StringBuffer rc = new StringBuffer();
    boolean first = true;
    for (Iterator i = ws.iterator(); i.hasNext(); ) {
      if (first) {
        first = false;
      } else {
        rc.append('_');
      }
      String w = (String)i.next();
      rc.append(w.toUpperCase());
    }
    return rc.toString();
  }

  /**
   *  get indentifier in AST indentifier 4 format. All words are in upercased
   *  format. {Word1 word2 WOrd3} =>word1Word2WOrd3.
   *
   * @@param  s  input indentifer
   * @@return    value in id4 format
   * @@since     0.0.1
   */
  public static String getId4(String s) {
    List ws = parseId(s);
    StringBuffer rc = new StringBuffer();
    boolean first = true;
    for (Iterator i = ws.iterator(); i.hasNext(); ) {
      String w = (String)i.next();
      if (first) {
        first = false;
        rc.append(w.toLowerCase());
      } else {
        rc.append(Character.toUpperCase(w.charAt(0)));
        rc.append(w.substring(1));
      }
    }
    return rc.toString();
  }
  /**
   *  make first letter of string uppercased
   *
   * @@param  a  string to process
   * @@return    processed string
   * @@since     0.0.1
   */
  public static String uname(String a) {
    if (a.length() > 0) {
      return a.substring(0, 1).toUpperCase() + a.substring(1);
    } else {
      return a;
    }
  }


  /**
   *  chick if character is letter
   *
   * @@param  c  character to test
   * @@return    true if character is letter
   * @@since     0.0.1
   */
  private static boolean isLetter(char c) {
    return isULetter(c) || isLLetter(c);
  }


  /**
   *  chick if character is lower case letter
   *
   * @@param  c  character to test
   * @@return    true if character is lower case letter
   * @@since     0.0.1
   */
  private static boolean isLLetter(char c) {
    return c >= 'a' && c <= 'z';
  }


  /**
   *  chick if character is upper case letter
   *
   * @@param  c  character to test
   * @@return    true if character is upper case letter
   * @@since     0.1.0
   */
  private static boolean isULetter(char c) {
    return c >= 'A' && c <= 'Z';
  }


  /**
   *  chick if character is digit
   *
   * @@param  c  character to test
   * @@return    true if character is digit
   * @@since     0.1.0
   */
  private static boolean isDigit(char c) {
    return c >= '0' && c <= '9';
  }


  /**
   *  this method parse name to list of words
   *
   * @@param  s  name
   * @@return    list of words (as java.lang.String)
   * @@since     0.1.0
   */
  private static List parseId(String s) {
    List rc = new ArrayList();
    final int LC = 0;
    // lower case letter
    final int UC = 1;
    // lower case letter
    final int NW = 2;
    // non word indentifier
    int state = NW;
    // state of last character
    final int n = s.length();
    int start = -1;
    int end = -1;
    for (int i = 0; i < n; i++) {
      final char c = s.charAt(i);
      switch (state) {
        case NW:
          // Treat a digit following a non-word character the same as
          // an upper case letter if we're not in the first word
          // this allows us to support names like 'imsat_1' from the CWM model
          // patch from rvermillion@@users.sourceforge.net
          if (isULetter(c) || (isDigit(c) && (rc.size() > 0))) {
            start = i;
            state = UC;
          } else if (isLLetter(c)) {
            start = i;
            state = LC;
          }
          break;
        case LC:
          if (isDigit(c) || isLLetter(c)) {
            // do nothing
          } else {
            rc.add(s.substring(start, i));
            if (isULetter(c)) {
              start = i;
              state = UC;
            } else {
              start = -1;
              state = NW;
            }
          }
          break;
        case UC:
          if (isDigit(c) || isULetter(c)) {
            // do nothing
          } else if (isLLetter(c)) {
            state = LC;
          } else {
            rc.add(s.substring(start, i));
            start = -1;
            state = NW;
          }
          break;
      }
    }
    if (start != -1) {
      rc.add(s.substring(start));
    }
    //System.out.println( s + " -- " + rc );
    return rc;
  }

}

